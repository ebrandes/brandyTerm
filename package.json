{
  "name": "brandyterm",
  "version": "0.1.0",
  "description": "Desktop terminal for multi-agent orchestration of AI coding agents: run Claude Code and Codex side by side with a coordinator, kanban board and approvals. Built with Electron.",
  "keywords": [
    "ai-agents",
    "ai-coding-agents",
    "claude-code",
    "codex",
    "multi-agent",
    "agent-orchestration",
    "claude-agent-sdk",
    "electron",
    "desktop-terminal",
    "kanban",
    "react",
    "typescript"
  ],
  "homepage": "https://github.com/ebrandes/brandyTerm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ebrandes/brandyTerm.git"
  },
  "bugs": {
    "url": "https://github.com/ebrandes/brandyTerm/issues"
  },
  "license": "MIT",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "predev": "node scripts/update-sdk.mjs",
    "dev": "electron-vite dev -w",
    "dev:second": "BRANDY_USER_DATA=$TMPDIR/brandy-second electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postinstall": "node scripts/fetch-plugins.mjs",
    "plugins": "node scripts/fetch-plugins.mjs",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "latest",
    "@lydell/node-pty": "^1.1.0",
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "bonjour-service": "^1.4.4",
    "lucide-react": "^1.79.0",
    "mermaid": "^12.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^33.2.0",
    "electron-vite": "^2.3.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
